#!/usr/bin/env bash
# `oanastack trigger` is the local herdr notifier (packages/oanastack-trigger).
# When packages/oanastack from the progress dashboard is present, every other
# subcommand is forwarded there. Keep this dispatch on merge.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TRIGGER_PKG="${REPO_ROOT}/packages/oanastack-trigger"
DASH_PKG="${REPO_ROOT}/packages/oanastack"
TRIGGER_CLI="${TRIGGER_PKG}/dist/cli.js"
DASH_CLI="${DASH_PKG}/dist/cli.js"

err() { echo "oanastack: $*" >&2; }

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    err "missing command: $1"
    exit 1
  fi
}

ensure_node() {
  need_cmd node
  node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 13)) { console.error("oanastack: Node.js >= 22.13 required (node:sqlite), current " + process.versions.node); process.exit(1); }'
}

ensure_built() {
  local pkg="$1" cli="$2"
  if [ -f "$cli" ]; then
    return
  fi
  if [ ! -f "$pkg/package.json" ]; then
    err "package missing at ${pkg}"
    exit 1
  fi
  need_cmd npm
  err "building $(basename "$pkg") (dist/cli.js missing)…"
  (
    cd "$pkg"
    if [ ! -d node_modules ]; then
      npm install
    fi
    npm run build
  )
  if [ ! -f "$cli" ]; then
    err "build did not produce ${cli}"
    err "run: (cd ${pkg} && npm install && npm run build)"
    exit 1
  fi
}

ensure_node

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  if [ -f "$DASH_PKG/package.json" ]; then
    ensure_built "$DASH_PKG" "$DASH_CLI"
    ensure_built "$TRIGGER_PKG" "$TRIGGER_CLI"
    node --disable-warning=ExperimentalWarning "$DASH_CLI" --help
    printf '\n%s\n' "trigger (herdr done/blocked -> Grok Bot webhook):"
    node --disable-warning=ExperimentalWarning "$TRIGGER_CLI" trigger --help
    exit 0
  fi
fi

if [ "${1:-}" = "trigger" ] || [ ! -f "$DASH_PKG/package.json" ]; then
  ensure_built "$TRIGGER_PKG" "$TRIGGER_CLI"
  exec node --disable-warning=ExperimentalWarning "$TRIGGER_CLI" "$@"
fi

ensure_built "$DASH_PKG" "$DASH_CLI"
exec node --disable-warning=ExperimentalWarning "$DASH_CLI" "$@"
