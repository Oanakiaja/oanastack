{
  "name": "@oana/oanastack-trigger",
  "version": "0.1.0",
  "private": true,
  "description": "Local trigger service that forwards herdr agent done/blocked events to a Grok Bot webhook.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "oanastack": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/ensure-shebang.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oanakiaja/oanastack.git",
    "directory": "packages/oanastack-trigger"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "citty": "^0.2.2",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
